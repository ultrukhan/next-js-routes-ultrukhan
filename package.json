{
  "name": "react-routes",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "next dev --hostname 127.0.0.1 -p 3456",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "e2e": "start-server-and-test dev:e2e http://127.0.0.1:3456 \"cypress open --e2e\"",
    "e2e:headless": "start-server-and-test dev:e2e http://127.0.0.1:3456 \"cypress run --e2e\""
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "cypress": "14.5.4",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "postcss": "8.5.28",
    "start-server-and-test": "2.1.5",
    "tailwindcss": "3.4.19"
  }
}
